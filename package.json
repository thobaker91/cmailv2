{
  "name": "cmailv2",
  "version": "3.0.0",
  "description": "Cmail \u2014 Liquid-glass email platform on Cloudflare Workers: temporary & permanent inboxes, notes, 2FA codes vault, multi-domain.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "node scripts/build-worker.mjs",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply cmail-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply cmail-db --remote",
    "check:i18n": "node scripts/check-i18n.mjs",
    "setup": "bash deploy.sh",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "postal-mime": "^2.4.1",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.95.0"
  }
}
